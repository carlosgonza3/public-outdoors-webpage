# Public build-time settings, never secrets. Include the subpath if used.
VITE_SITE_URL=https://publicoutdoors.com
VITE_BASE_PATH=/
# Enable only for the final production domain; previews stay noindex.
VITE_ALLOW_INDEXING=false

# Optional public Cloudflare Web Analytics token (not an API secret).
# Loaded only when indexing is enabled. Leave empty to disable analytics.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=
